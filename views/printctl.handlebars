<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Print Control</title>
<style>
  :root { color-scheme:light; --ink:#1c2b40; --muted:#64748b; --line:#dfe6ee; --blue:#205dcc; --soft:#edf4ff; }
  * { box-sizing:border-box; }
  [hidden] { display:none !important; }
  html,body { margin:0; min-height:100%; }
  body { padding:18px; color:var(--ink); background:#f4f7fb; font:13px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
  .app { overflow-anchor:none; max-width:1800px; margin:auto; }
  h1,h2,h3,p { margin:0; }
  h1 { font-size:21px; letter-spacing:-.6px; }
  h2 { font-size:14px; font-weight:650; }
  button,input,select { font:inherit; }
  button { min-height:34px; border:1px solid var(--line); border-radius:6px; padding:6px 11px; color:var(--ink); background:white; cursor:pointer; font-weight:550; }
  button:hover { background:#f3f7fc; border-color:#bdccdf; }
  button:disabled { opacity:.5; cursor:not-allowed; }
  button.primary { background:var(--blue); border-color:var(--blue); color:white; }
  button.primary:hover { background:#174cac; }
  button.danger { color:#a72d3d; border-color:#e8c5cb; background:white; }
  button.danger:hover { background:#fff2f3; }
  :focus-visible { outline:3px solid #80abfa; outline-offset:2px; }
  .app-head { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-bottom:17px; }
  .brand { display:flex; gap:12px; align-items:center; }
  .brand-mark { width:39px; height:39px; display:grid; place-items:center; border-radius:10px; background:var(--blue); color:white; flex-shrink:0; }
  .brand-mark svg { width:23px; height:23px; }
  .subtext,.help { color:var(--muted); font-size:12px; }
  .head-actions { display:flex; align-items:center; gap:9px; }
  #cfgState { font-size:11px; color:var(--muted); }
  #cfgState.bad { color:#a72d3d; }
  .refresh-meta { text-align:right; }
  #refreshBtn { min-width:125px; }
  #lastUpdated { display:block; color:var(--muted); font-size:11px; }
  .stats { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; margin-bottom:16px; }
  .stat { display:grid; grid-template-columns:1fr auto; text-align:left; gap:5px 12px; padding:13px 15px; border-radius:9px; background:white; min-width:0; }
  .stat[aria-pressed="true"] { background:var(--soft); border-color:#92b5f1; box-shadow:inset 0 0 0 1px #92b5f1; }
  .stat-label { align-self:center; font-size:12px; font-weight:600; }
  .stat-value { font-size:25px; line-height:1.2; font-weight:650; letter-spacing:-.8px; }
  .stat small { grid-column:1/-1; color:var(--muted); font-size:11px; font-weight:400; }
  .stat[data-filter="ready"] .stat-value { color:#21724f; }
  .stat[data-filter="attention"] .stat-value { color:#9b6512; }
  .stat[data-filter="unknown"] .stat-value { color:var(--muted); }
  .main-grid { display:grid; grid-template-columns:minmax(0,1fr); gap:16px; align-items:start; }
  .main-grid.with-selection { grid-template-columns:minmax(0,1fr) 380px; }
  .panel { background:white; border:1px solid var(--line); border-radius:10px; overflow:hidden; min-width:0; }
  .inventory-head { display:flex; align-items:center; justify-content:space-between; gap:14px; padding:14px 16px 10px; }
  .inventory-head .help { font-size:11px; margin-top:2px; }
  .filters { display:flex; align-items:end; gap:10px; padding:0 16px 12px; flex-wrap:wrap; }
  .field { display:block; min-width:0; }
  .field span { display:block; font-size:11px; font-weight:550; margin-bottom:4px; color:var(--muted); }
  .search-field { flex:1 1 250px; }
  input[type=search],select { width:100%; min-height:35px; border:1px solid #cbd6e3; border-radius:6px; background:white; padding:6px 9px; color:var(--ink); }
  #serverFilter { min-width:165px; max-width:270px; }
  #resetFilters { color:var(--blue); border-color:transparent; font-size:12px; }
  .table-wrap { overflow:auto; max-height:560px; }
  #printersTable { width:100%; border-collapse:collapse; font-size:12px; min-width:850px; }
  th,td { padding:12px 15px; text-align:left; vertical-align:top; border-bottom:1px solid #edf1f6; }
  th { position:sticky; top:0; z-index:1; color:var(--muted); background:#f9fbfd; font-size:11px; font-weight:550; }
  tr.printer { cursor:pointer; }
  tr.printer:hover { background:#f7faff; }
  tr.printer.selected { background:var(--soft); }
  tr.printer.selected td:first-child { box-shadow:inset 3px 0 var(--blue); }
  .printer-link { border:0; padding:0; min-height:20px; text-align:left; background:transparent; color:var(--ink); font-size:12px; font-weight:650; }
  .printer-link:hover { background:transparent; color:var(--blue); }
  .printer-name { display:flex; gap:7px; align-items:center; }
  .printer-path { display:block; color:var(--muted); font-size:10px; margin-top:4px; max-width:235px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .model-cell { max-width:215px; }
  .model-name { overflow-wrap:anywhere; }
  .status-cell { min-width:225px; }
  .mono { font:11px/1.5 Menlo,Consolas,monospace; color:#5e6c80; }
  .dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; display:inline-block; }
  .dot.alive { background:#26835b; } .dot.dead { background:#ca5363; } .dot.warn { background:#d09a36; } .dot.unknown { background:#a4afbd; }
  .chip,.badge { display:inline-block; border-radius:5px; padding:2px 6px; font-size:10px; margin:0 3px 2px 0; line-height:1.5; }
  .chip.ok { color:#1c6546; background:#e7f5ed; }
  .chip.warn,.badge.jobs { color:#805b16; background:#fff3da; }
  .chip.bad { color:#a12b3b; background:#fcecef; }
  .chip.na,.badge.idle { color:#64748b; background:#eef2f6; }
  .primary-status .chip { font-size:11px; font-weight:550; }
  .status-detail { display:block; color:var(--muted); font-size:10px; margin-top:3px; line-height:1.5; }
  .empty { color:var(--muted); }
  .empty-state { text-align:center; padding:30px 18px; color:var(--muted); }
  .empty-state strong { display:block; color:#455771; font-size:13px; font-weight:550; margin-bottom:5px; }
  .inventory-foot { border-top:1px solid var(--line); padding:9px 15px; display:flex; justify-content:space-between; gap:12px; color:var(--muted); font-size:11px; }
  #resultCount { font-weight:550; color:#4e627c; }
  #jobsPanel { position:sticky; top:16px; }
  .detail-head { padding:15px; border-bottom:1px solid var(--line); }
  .detail-title-line { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px; }
  .eyebrow { color:var(--muted); font-size:10px; letter-spacing:.8px; text-transform:uppercase; }
  #jobsTitle { font-size:17px; font-weight:650; overflow-wrap:anywhere; }
  #jobsSubtitle { font-size:11px; color:var(--muted); margin-top:3px; overflow-wrap:anywhere; }
  #jobsClose { min-height:26px; padding:2px 7px; font-size:11px; }
  #printerDetails { padding:12px 15px; border-bottom:1px solid var(--line); }
  #printerDetails dl { display:grid; grid-template-columns:80px minmax(0,1fr); gap:5px 8px; margin:10px 0 0; font-size:11px; }
  #printerDetails dt { color:var(--muted); } #printerDetails dd { margin:0; overflow-wrap:anywhere; }
  .jobs-toolbar { display:flex; align-items:center; gap:8px; padding:12px 15px 8px; }
  .jobs-toolbar h3 { font-size:12px; margin-right:auto; }
  #jobsRefresh { font-size:11px; min-height:28px; padding:4px 8px; }
  #jobsBody { max-height:380px; overflow:auto; padding:0 15px 5px; }
  .job-card { border:1px solid var(--line); border-radius:7px; padding:11px; margin:7px 0; }
  .job-head { display:flex; align-items:start; justify-content:space-between; gap:8px; }
  .job-document { font-size:12px; font-weight:600; overflow-wrap:anywhere; }
  .job-meta { font-size:11px; color:var(--muted); display:flex; flex-wrap:wrap; gap:4px 12px; margin-top:7px; overflow-wrap:anywhere; }
  .job-id { font-size:10px; color:var(--muted); white-space:nowrap; }
  .detail-foot { padding:12px 15px; background:#fafbfd; border-top:1px solid var(--line); }
  #jobsPurge { width:100%; font-size:12px; }
  #purgeMessage { margin-bottom:10px; font-size:12px; overflow-wrap:anywhere; }
  #purgeMessage:empty { display:none; }
  #purgeMessage.error,.error-text { color:#a12b3b; }
  #jobsLive { min-height:16px; margin:0 15px 5px; color:var(--muted); font-size:11px; }
  @media(max-width:1100px) { .main-grid.with-selection { grid-template-columns:1fr; } #jobsPanel { position:static; } #jobsBody { display:grid; grid-template-columns:1fr 1fr; gap:10px; } .job-card { margin:5px 0; } }
  @media(max-width:650px) { body { padding:10px; } .app-head { align-items:start; flex-direction:column; gap:12px; } .head-actions { width:100%; justify-content:space-between; } .refresh-meta { text-align:left; } .stats { grid-template-columns:1fr 1fr; gap:8px; } .stat { padding:11px; } .stat small { min-height:30px; } .inventory-head { align-items:start; } #serverFilter { max-width:100%; } .filters .field { flex:1 1 100%; } .inventory-foot { flex-direction:column; gap:3px; } #jobsBody { display:block; } .table-wrap { max-height:430px; } }
</style>
</head>
<body>
<div class="app">
  <header class="app-head">
    <div class="brand"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 8V3h12v5M6 17H3V8h18v9h-3M6 14h12v7H6z"/><path d="M17 11h1"/></svg></span><div><h1>Print Control</h1><p class="subtext">Votre parc d’imprimantes, ses états et ses travaux.</p></div></div>
    <div class="head-actions"><div class="refresh-meta"><span id="cfgState" role="status">Connexion aux serveurs…</span><span id="lastUpdated">Actualisation automatique · 30 s</span></div><button id="refreshBtn" class="primary">Rafraîchir</button></div>
  </header>
  <nav class="stats" aria-label="Filtrer les imprimantes par état">
    <button class="stat" data-filter="all" aria-pressed="true"><span class="stat-label">Toutes les imprimantes</span><span id="countAll" class="stat-value">—</span><small>Parc du serveur sélectionné</small></button>
    <button class="stat" data-filter="ready" aria-pressed="false"><span class="stat-label">Prêtes</span><span id="countReady" class="stat-value">—</span><small>Files Windows sans alerte</small></button>
    <button class="stat" data-filter="attention" aria-pressed="false"><span class="stat-label">À surveiller</span><span id="countAttention" class="stat-value">—</span><small>Alertes, pauses ou activité</small></button>
    <button class="stat" data-filter="unknown" aria-pressed="false"><span class="stat-label">État inconnu</span><span id="countUnknown" class="stat-value">—</span><small>État de la file non confirmé</small></button>
  </nav>
  <main id="mainGrid" class="main-grid">
    <section class="panel" aria-labelledby="inventoryTitle">
      <div class="inventory-head"><div><h2 id="inventoryTitle">Imprimantes</h2><p id="srvHost" class="help">Chargement des serveurs…</p></div><span id="resultCount" aria-live="polite"></span></div>
      <div class="filters"><label class="field search-field" for="search"><span>Rechercher</span><input id="search" type="search" placeholder="Nom, adresse IP, modèle ou emplacement…"></label><label class="field" for="serverFilter"><span>Serveur d’impression</span><select id="serverFilter"><option value="">Tous les serveurs</option></select></label><button id="resetFilters" hidden>Effacer les filtres</button></div>
      <div id="tableScroll" class="table-wrap"><table id="printersTable"><thead><tr><th>Imprimante</th><th>Emplacement</th><th>Port / IP</th><th>Modèle</th><th>Statut</th><th>Travaux</th></tr></thead><tbody id="tbody"><tr><td colspan="6" class="empty-state">Chargement du parc…</td></tr></tbody></table></div>
      <footer class="inventory-foot"><span>Cliquez sur une imprimante pour ouvrir sa file d’attente.</span><span>Windows · état de la file &nbsp; / &nbsp; SNMP · état matériel</span></footer>
    </section>
    <aside id="jobsPanel" class="panel" aria-labelledby="jobsTitle" hidden>
      <div class="detail-head"><div class="detail-title-line"><span class="eyebrow">File d’attente</span><button id="jobsClose">Fermer</button></div><h2 id="jobsTitle" tabindex="-1"></h2><p id="jobsSubtitle"></p></div>
      <div id="printerDetails"></div>
      <div class="jobs-toolbar"><h3>Travaux <span id="jobsCount" class="badge idle">—</span></h3><button id="jobsRefresh">Actualiser la file</button></div>
      <p id="jobsLive" role="status" aria-live="polite"></p><div id="jobsBody"></div>
      <div class="detail-foot"><p id="purgeMessage" role="status" aria-live="polite"></p><button id="jobsPurge" class="danger" disabled>Vider la file</button></div>
    </aside>
  </main>
</div>

<script>
  function $(id) { return document.getElementById(id); }
  function api(action, params) {
    var qs = 'action=' + encodeURIComponent(action);
    if (params) Object.keys(params).forEach(function (k) {
      qs += '&' + encodeURIComponent(k) + '=' + encodeURIComponent(params[k]);
    });
    return fetch('/pluginadmin.ashx?pin=printctl&' + qs, { credentials: 'include' }).then(function (r) { return r.json(); });
  }
  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
    });
  }

  // Unchanged content keeps its DOM nodes, focus and scroll positions.
  function setHtml(id, html) {
    var element = $(id);
    if (element._printctlHtml === html) return;
    element.innerHTML = html;
    element._printctlHtml = html;
  }
  function preserveView(update) {
    var positions = ['tableScroll', 'jobsBody'].map(function (id) {
      var element = $(id);
      return { element: element, top: element.scrollTop, left: element.scrollLeft };
    });
    var x = window.scrollX, y = window.scrollY;
    update();
    positions.forEach(function (p) { p.element.scrollTop = p.top; p.element.scrollLeft = p.left; });
    if (window.scrollX !== x || window.scrollY !== y) window.scrollTo(x, y);
  }
  function liveSnapshot() {
    return { data: data, pingState: pingState, modelState: modelState, statusState: statusState, jobCountState: jobCountState };
  }

  var data = null;
  var selectedPrinter = null;
  // ip -> true when reachable, null when unconfirmed, undefined while probing.
  var pingState = {};
  // ip -> model string (or "" once we know there is none).
  var modelState = {};
  // "host|PrinterShortName" -> live job count from WMI (overrides rpcclient cjobs).
  var jobCountState = {};
  // ip -> {state: "prête"|"imprime"|…, errors: ["bourrage", "papier bas", …]}
  var statusState = {};
  // Periodic background refresh for the job-count column.
  var refreshTimer = null;
  var loadBusy = false;
  var activeFilter = 'all';
  var jobsRows = [], jobsLoading = false, jobsLoaded = false, jobsError = '';
  var jobsRequest = 0, purgeBusy = false;

  function printerIndicator(p) {
    var queue = p.queueStatus;
    if (queue && queue.known) {
      var levels = queue.states.map(function (s) { return s.level; });
      return { css: levels.indexOf('bad') !== -1 ? 'dead' : levels.indexOf('warn') !== -1 ? 'warn' : levels.indexOf('na') !== -1 ? 'unknown' : 'alive',
        title: 'Windows : ' + queue.states.map(function (s) { return s.label; }).join(', ') };
    }
    var snmp = statusState[p.ip];
    if (snmp && snmp.available && snmp.errors.length) return { css: 'warn', title: 'Alerte signalée par SNMP' };
    return pingState[p.ip] === true || (snmp && snmp.available)
      ? { css: 'alive', title: 'Joignable depuis MeshCentral ; état Windows inconnu' }
      : { css: 'unknown', title: 'État non confirmé' };
  }

  // The Windows queue, direct network access and SNMP are different observations.
  // Label each source and never turn a failed probe into an offline/OK assertion.
  function statusHtml(p) {
    var html = '';
    var queue = p.queueStatus;
    if (queue && queue.known) {
      html = queue.states.map(function (s) {
        var level = ['ok', 'warn', 'bad', 'na'].indexOf(s.level) !== -1 ? s.level : 'na';
        return '<span class="chip ' + level + '">Windows : ' + escapeHtml(s.label) + '</span>';
      }).join('');
    } else html = '<span class="chip na">État Windows inconnu</span>';
    html = '<div class="primary-status">' + html + '</div>';
    var ip = p.ip;
    if (!ip) return html + '<span class="status-detail">Adresse IP non identifiée</span>';
    var s = statusState[ip];
    if (s && s.available) {
      if (s.errors.length) {
        html += s.errors.map(function (e) {
          return '<span class="chip bad">SNMP : ' + escapeHtml(e) + '</span>';
        }).join('');
      } else if (s.stateCode >= 3 && s.errorsKnown) {
        html += '<span class="chip ' + (s.stateCode === 3 ? 'ok' : 'warn') + '">SNMP : ' + escapeHtml(s.state) + '</span>';
      } else html += '<span class="status-detail">État SNMP incomplet</span>';
    } else if (s !== undefined) html += '<span class="status-detail">État SNMP indisponible</span>';
    var reachable = pingState[ip] === true || (s && s.available);
    html += '<span class="status-detail">' + (reachable ? 'Joignable depuis MeshCentral'
      : pingState[ip] === undefined ? 'Vérification réseau…' : 'Accès direct non confirmé') + '</span>';
    return html;
  }

  function shortName(p) { return (p.printername || '').split('\\').pop(); }
  function printerKey(p) { return (p.server || '') + '|' + shortName(p); }
  function selectedMatches(name, host) { return selectedPrinter && selectedPrinter.name === name && selectedPrinter.host === (host || ''); }
  function selectedRecord() {
    return data && selectedPrinter && data.printers.find(function (p) { return selectedMatches(shortName(p), p.server); });
  }
  function printerCategory(p) {
    var queue = p.queueStatus;
    var snmp = statusState[p.ip];
    if (snmp && snmp.available && snmp.errors && snmp.errors.length) return 'attention';
    if (!queue || !queue.known || !Array.isArray(queue.states) || !queue.states.length) return 'unknown';
    if (queue.states.some(function (s) { return s.level === 'bad' || s.level === 'warn'; })) return 'attention';
    return queue.states.every(function (s) { return s.level === 'ok'; }) ? 'ready' : 'unknown';
  }
  function jobCount(p) {
    var key = printerKey(p);
    return Object.prototype.hasOwnProperty.call(jobCountState, key) ? jobCountState[key] : (p.cjobs || 0);
  }
  function serverPrinters() {
    var server = $('serverFilter').value;
    return (data && data.printers || []).filter(function (p) { return !server || p.server === server; });
  }
  function visiblePrinters() {
    var query = ($('search').value || '').toLowerCase().trim();
    return serverPrinters().filter(function (p) {
      if (activeFilter !== 'all' && printerCategory(p) !== activeFilter) return false;
      return !query || [p.printername, p.sharename, p.portname, p.ip, p.drivername, modelState[p.ip], p.comment, p.location, p.server]
        .some(function (v) { return String(v || '').toLowerCase().indexOf(query) !== -1; });
    });
  }
  function renderCounters() {
    var counts = { all: 0, ready: 0, attention: 0, unknown: 0 };
    serverPrinters().forEach(function (p) { counts.all++; counts[printerCategory(p)]++; });
    [['all','countAll'],['ready','countReady'],['attention','countAttention'],['unknown','countUnknown']].forEach(function (item) { $(item[1]).textContent = counts[item[0]]; });
    [].slice.call(document.querySelectorAll('.stat[data-filter]')).forEach(function (button) {
      button.setAttribute('aria-pressed', String(button.getAttribute('data-filter') === activeFilter));
    });
    $('resetFilters').hidden = !($('search').value || $('serverFilter').value || activeFilter !== 'all');
  }
  function updateServers() {
    var selected = $('serverFilter').value;
    var hosts = Array.from(new Set((data.printers || []).map(function (p) { return p.server; }).filter(Boolean))).sort();
    setHtml('serverFilter', '<option value="">Tous les serveurs</option>' + hosts.map(function (host) {
      return '<option value="' + escapeHtml(host) + '">' + escapeHtml(host) + '</option>';
    }).join(''));
    $('serverFilter').value = hosts.indexOf(selected) !== -1 ? selected : '';
  }
  function render() {
    if (!data) return;
    renderCounters();
    var rows = visiblePrinters();
    $('resultCount').textContent = rows.length + ' / ' + serverPrinters().length + ' affichée' + (rows.length > 1 ? 's' : '');
    setHtml('tbody', rows.map(function (p) {
      var name = shortName(p);
      var selected = selectedMatches(name, p.server);
      var indicator = printerIndicator(p);
      var model = modelState[p.ip];
      var modelCell = '<span class="model-name">' + escapeHtml(model || p.drivername || 'Modèle inconnu') + '</span>'
        + (!model && p.drivername ? '<span class="status-detail">Pilote Windows</span>' : '');
      var count = jobCount(p);
      var share = p.sharename ? '\\\\' + (p.server || '') + '\\' + p.sharename : p.printername;
      return '<tr class="printer' + (selected ? ' selected' : '') + '" data-name="' + escapeHtml(name) + '" data-host="' + escapeHtml(p.server || '') + '">'
        + '<td><div class="printer-name"><span class="dot ' + indicator.css + '" title="' + escapeHtml(indicator.title) + '"></span>'
        + '<button class="printer-link" aria-controls="jobsPanel" aria-expanded="' + !!selected + '" aria-label="Voir la file de ' + escapeHtml(name) + ' sur ' + escapeHtml(p.server || '') + '"' + (purgeBusy ? ' disabled' : '') + '>' + escapeHtml(name) + '</button></div>'
        + '<span class="printer-path" title="' + escapeHtml(share) + '">' + escapeHtml(share) + '</span></td>'
        + '<td>' + escapeHtml(p.location || '—') + '</td><td class="mono">' + escapeHtml(p.ip || p.portname || '—') + '</td>'
        + '<td class="model-cell">' + modelCell + '</td><td class="status-cell">' + statusHtml(p) + '</td>'
        + '<td><span class="badge ' + (count > 0 ? 'jobs' : 'idle') + '">' + (count > 0 ? count + (count > 1 ? ' travaux' : ' travail') : 'Vide') + '</span></td></tr>';
    }).join('') || '<tr><td colspan="6" class="empty-state"><strong>' + (data.printers.length ? 'Aucune imprimante pour ces filtres.' : 'Aucune imprimante disponible.') + '</strong>' + (data.printers.length ? 'Modifiez la recherche ou effacez les filtres.' : 'Vérifiez la connexion au serveur d’impression.') + '</td></tr>');
    [].slice.call(document.querySelectorAll('tr.printer')).forEach(function (tr) {
      tr.onclick = function () { openJobs(tr.getAttribute('data-name'), tr.getAttribute('data-host')); };
    });
    renderPrinterDetails();
  }
  function renderPrinterDetails() {
    $('jobsPanel').hidden = !selectedPrinter;
    $('mainGrid').className = 'main-grid' + (selectedPrinter ? ' with-selection' : '');
    if (!selectedPrinter) return;
    $('jobsTitle').textContent = selectedPrinter.name;
    $('jobsSubtitle').textContent = selectedPrinter.host;
    var p = selectedRecord();
    if (!p) {
      setHtml('printerDetails', '<p class="help">Cette imprimante n’est plus présente dans l’inventaire courant.</p>');
      return;
    }
    var fields = [['Emplacement',p.location],['Adresse',p.ip || p.portname],['Partage',p.sharename],['Modèle',modelState[p.ip] || p.drivername]];
    setHtml('printerDetails', statusHtml(p) + '<dl>' + fields.filter(function (f) { return f[1]; }).map(function (f) {
      return '<dt>' + f[0] + '</dt><dd>' + escapeHtml(f[1]) + '</dd>';
    }).join('') + '</dl>');
  }
  function jobStatusLabel(job) {
    var raw = job.status || job.jobstatus || '';
    return { Printing: 'Impression', Spooling: 'Préparation', Paused: 'Suspendu', Error: 'Erreur', Offline: 'Hors connexion',
      Deleting: 'Suppression', Deleted: 'Supprimé', Printed: 'Imprimé', Complete: 'Terminé', 'OK': 'Prêt' }[raw] || raw || 'État non renseigné';
  }
  function renderJobs() {
    $('jobsRefresh').disabled = jobsLoading || purgeBusy;
    $('jobsClose').disabled = purgeBusy;
    $('jobsPurge').disabled = purgeBusy || jobsLoading || !!jobsError || !jobsLoaded || !jobsRows.length;
    $('jobsPurge').textContent = purgeBusy ? 'Suppression en cours…' : 'Vider la file';
    $('jobsCount').textContent = jobsLoaded ? jobsRows.length : '—';
    $('jobsLive').textContent = jobsLoading ? 'Lecture des travaux…' : jobsError ? 'Lecture impossible : ' + jobsError + (jobsLoaded ? ' · Derniers travaux connus.' : '') : jobsLoaded ? jobsRows.length + (jobsRows.length > 1 ? ' travaux' : ' travail') + ' dans la file.' : '';
    if (jobsLoaded && (jobsLoading || jobsError)) return;
    if (jobsLoading) { setHtml('jobsBody', '<div class="empty-state">Chargement des travaux…</div>'); return; }
    if (jobsError) { setHtml('jobsBody', '<div class="empty-state error-text"><strong>La file est indisponible.</strong>' + escapeHtml(jobsError) + '</div>'); return; }
    setHtml('jobsBody', jobsRows.map(function (j) {
      var submitted = j.submitted || '';
      var match = submitted.match(/^(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})/);
      if (match) submitted = match[3] + '/' + match[2] + '/' + match[1] + ' à ' + match[4] + ':' + match[5];
      var pages = (j.pagesprinted || '0') + ' / ' + (j.totalpages || '?') + ' pages';
      var size = Number(j.size) > 0 ? Math.round(Number(j.size) / 1024) + ' Ko' : '';
      return '<article class="job-card"><div class="job-head"><span class="job-document">' + escapeHtml(j.document || 'Document sans nom') + '</span><span class="job-id">#' + escapeHtml(j.jobid) + '</span></div>'
        + '<div class="job-meta"><span class="chip na">' + escapeHtml(jobStatusLabel(j)) + '</span><span>' + escapeHtml(j.owner || 'Utilisateur inconnu') + '</span></div>'
        + '<div class="job-meta"><span>' + escapeHtml(pages) + '</span><span>' + escapeHtml(size) + '</span></div>'
        + (submitted ? '<div class="status-detail">Soumis le ' + escapeHtml(submitted) + ' · heure du serveur</div>' : '') + '</article>';
    }).join('') || '<div class="empty-state"><strong>La file est vide.</strong>Aucun document en attente sur cette imprimante.</div>');
  }
  function openJobs(name, host) {
    if (purgeBusy) return Promise.resolve();
    if (!selectedMatches(name, host)) { jobsLoaded = false; jobsRows = []; jobsError = ''; }
    selectedPrinter = { name: name, host: host || '' };
    $('purgeMessage').textContent = '';
    render();
    $('jobsTitle').focus({ preventScroll: true });
    $('jobsPanel').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    return refreshJobs();
  }
  function refreshJobs() {
    if (!selectedPrinter || purgeBusy) return Promise.resolve();
    var request = ++jobsRequest;
    var target = { name: selectedPrinter.name, host: selectedPrinter.host };
    jobsLoading = true; jobsError = '';
    renderJobs();
    return api('jobs', { printer: target.name, host: target.host }).then(function (r) {
      if (request !== jobsRequest || !selectedMatches(target.name, target.host)) return;
      if (!r || r.error || !Array.isArray(r.jobs)) throw new Error(r && r.error || 'Réponse du serveur invalide');
      jobsRows = r.jobs; jobsLoaded = true;
      jobCountState[target.host + '|' + target.name] = r.jobs.length;
      preserveView(render);
    }).catch(function (e) {
      if (request === jobsRequest && selectedMatches(target.name, target.host)) jobsError = e.message;
    }).then(function () {
      if (request !== jobsRequest || !selectedMatches(target.name, target.host)) return;
      jobsLoading = false;
      preserveView(renderJobs);
    });
  }
  function closeJobs() {
    if (purgeBusy) return;
    jobsRequest++;
    selectedPrinter = null; jobsLoaded = false; jobsRows = []; jobsLoading = false;
    render();
  }
  function purgeJobs() {
    if (!selectedPrinter || purgeBusy || jobsLoading || !jobsLoaded || !jobsRows.length || jobsError) return Promise.resolve();
    var target = { name: selectedPrinter.name, host: selectedPrinter.host };
    if (!confirm('Vider toute la file de ' + target.name + ' sur ' + target.host + ' ?\n\nLes travaux seront supprimés sur le serveur d’impression.')) return Promise.resolve();
    purgeBusy = true;
    $('purgeMessage').textContent = '';
    $('purgeMessage').className = '';
    render(); renderJobs();
    return api('purge', { printer: target.name, host: target.host }).then(function (r) {
      if (!r || r.error || typeof r.deleted !== 'number') throw new Error(r && r.error || 'Résultat de suppression non confirmé');
      var message = r.deleted + (r.deleted > 1 ? ' travaux supprimés' : ' travail supprimé') + '.';
      if (r.failed) message += ' ' + r.failed + ' échec(s).' + (r.errors && r.errors[0] ? ' ' + (r.errors[0].error || '') : '');
      else if (!r.deleted) message += ' Aucun travail supprimé ; vérification de la file…';
      $('purgeMessage').textContent = message;
      $('purgeMessage').className = r.failed ? 'error' : '';
    }).catch(function (e) {
      $('purgeMessage').textContent = 'Suppression impossible : ' + e.message;
      $('purgeMessage').className = 'error';
    }).then(function () {
      purgeBusy = false;
      render(); renderJobs();
      // Re-read the queue. A partial purge must never optimistically show it empty.
      return countsAll().then(refreshJobs);
    });
  }

  function load(manual) {
    if (loadBusy) return Promise.resolve();
    loadBusy = true;
    $('refreshBtn').disabled = true;
    $('refreshBtn').textContent = 'Actualisation…';
    if (!data) $('tbody').innerHTML = '<tr><td colspan="6" class="empty-state">Chargement…</td></tr>';
    return api('list').then(function (r) {
      if (!r || r.error || !Array.isArray(r.printers)) throw new Error(r && r.error || 'Inventaire invalide');
      // Collect a complete refresh away from the displayed state. Slow probes
      // must not temporarily remove alerts, filtered rows or the open queue.
      var next = { data: r, pingState: {}, statusState: {}, modelState: Object.assign({}, modelState), jobCountState: {} };
      if (!data) { data = r; updateServers(); render(); }
      return Promise.all([pingAll(next), modelsAll(next), statusAll(manual !== false, next), countsAll(next)]).then(function () {
        preserveView(function () {
          data = next.data; pingState = next.pingState; statusState = next.statusState;
          modelState = next.modelState; jobCountState = next.jobCountState;
          updateServers();
          var errors = (r.errors || []).map(function (e) { return e.host + ' : ' + e.error; });
          $('cfgState').textContent = errors.length ? 'Inventaire partiel : ' + errors.join(' · ') : 'Serveurs connectés';
          $('cfgState').className = errors.length ? 'pill bad' : 'pill ok';
          $('lastUpdated').textContent = 'Inventaire à ' + new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) + ' · actualisation 30 s';
          render();
        });
        if (selectedPrinter && !purgeBusy) return refreshJobs();
      });
    }).catch(function (e) {
      $('cfgState').textContent = 'Actualisation impossible : ' + e.message;
      $('cfgState').className = 'pill bad';
      if (data) {
        // A stale Windows state is not evidence of current availability.
        data.printers.forEach(function (p) { p.queueStatus = { known: false }; });
        pingState = {}; statusState = {};
        preserveView(render);
      }
    }).then(function () {
      loadBusy = false;
      $('refreshBtn').disabled = false;
      $('refreshBtn').textContent = 'Rafraîchir';
    });
  }

  // Probe each unique IPv4 port-name with at most 8 concurrent requests.
  // Resolve once the snapshot contains every result.
  function pingAll(snapshot) {
    var current = snapshot || liveSnapshot();
    if (!current.data) return Promise.resolve();
    var ips = {};
    (current.data.printers || []).forEach(function (p) {
      if (p.ip) ips[p.ip] = true;
    });
    var queue = Object.keys(ips);
    if (!queue.length) return Promise.resolve();
    var i = 0;
    function worker() {
      if (i >= queue.length) return Promise.resolve();
      var ip = queue[i++];
      return api('pingPrinter', { ip: ip }).then(function (r) {
        current.pingState[ip] = r && r.alive === true ? true : null;
      }).catch(function () { current.pingState[ip] = null; }).then(function () {
        if (!snapshot) preserveView(render);
        return worker();
      });
    }
    var workers = [];
    for (var k = 0; k < Math.min(8, queue.length); k++) workers.push(worker());
    return Promise.all(workers);
  }

  // Fetch missing models independently of ICMP. Retry empty results on refresh.
  function modelsAll(snapshot) {
    var current = snapshot || liveSnapshot();
    if (!current.data) return Promise.resolve();
    var ips = {};
    (current.data.printers || []).forEach(function (p) {
      if (p.ip && !current.modelState[p.ip]) ips[p.ip] = true;
    });
    var queue = Object.keys(ips);
    if (!queue.length) return Promise.resolve();
    var i = 0;
    function worker() {
      if (i >= queue.length) return Promise.resolve();
      var ip = queue[i++];
      return api('getModel', { ip: ip }).then(function (r) {
        if (r && typeof r.model === 'string') current.modelState[ip] = r.model;
      }).catch(function () {}).then(function () {
        if (!snapshot) preserveView(render);
        return worker();
      });
    }
    var workers = [];
    for (var k = 0; k < Math.min(8, queue.length); k++) workers.push(worker());
    return Promise.all(workers);
  }

  api('ping').then(function (r) {
    if (r && Array.isArray(r.hosts) && r.hosts.length) {
      $('srvHost').textContent = r.hosts.map(function (h) {
        return h.host + (h.ok ? ' (' + h.count + ')' : ' [' + (h.error || 'KO') + ']');
      }).join(' · ');
    }
  });
  // Query every IP: SNMP can respond even when ICMP/TCP probes fail.
  function statusAll(force, snapshot) {
    var current = snapshot || liveSnapshot();
    if (!current.data) return Promise.resolve();
    var ips = {};
    (current.data.printers || []).forEach(function (p) {
      if (p.ip) ips[p.ip] = true;
    });
    var queue = Object.keys(ips);
    if (!queue.length) return Promise.resolve();
    var i = 0;
    function worker() {
      if (i >= queue.length) return Promise.resolve();
      var ip = queue[i++];
      return api('getStatus', { ip: ip, force: force ? '1' : '0' }).then(function (r) {
        current.statusState[ip] = r && !r.error ? r : { available: false };
        if (!Array.isArray(current.statusState[ip].errors)) current.statusState[ip].errors = [];
      }).catch(function () { current.statusState[ip] = { available: false }; }).then(function () {
        if (!snapshot) preserveView(render);
        return worker();
      });
    }
    var workers = [];
    for (var k = 0; k < Math.min(8, queue.length); k++) workers.push(worker());
    return Promise.all(workers);
  }

  // Get the authoritative job counts via WMI, one query per server.
  function countsAll(snapshot) {
    var current = snapshot || liveSnapshot();
    if (!current.data) return Promise.resolve();
    var hosts = {};
    (current.data.printers || []).forEach(function (p) { if (p.server) hosts[p.server] = true; });
    return Promise.all(Object.keys(hosts).map(function (host) {
      return api('jobCounts', { host: host }).then(function (r) {
        if (!r || !r.counts) return;
        Object.keys(r.counts).forEach(function (printerName) {
          current.jobCountState[host + '|' + printerName] = r.counts[printerName];
        });
        if (!snapshot) preserveView(render);
      }).catch(function () {});
    }));
  }

  $('search').oninput = render;
  $('serverFilter').onchange = render;
  [].slice.call(document.querySelectorAll('.stat[data-filter]')).forEach(function (button) {
    button.onclick = function () { activeFilter = button.getAttribute('data-filter'); render(); };
  });
  $('resetFilters').onclick = function () { activeFilter = 'all'; $('search').value = ''; $('serverFilter').value = ''; render(); };
  $('refreshBtn').onclick = function () { load(true); };
  $('jobsRefresh').onclick = refreshJobs;
  $('jobsClose').onclick = closeJobs;
  $('jobsPurge').onclick = purgeJobs;
  load(true);
  refreshTimer = setInterval(function () { load(false); }, 30000);
</script>
</body>
</html>
