<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Print Control</title>
<style>
  html, body { height: 100%; margin: 0; }
  body { font-family: Segoe UI, Arial, sans-serif; font-size: 13px; padding: 10px; color: #222; box-sizing: border-box; display: flex; flex-direction: column; }
  h2 { margin: 0 0 10px 0; font-size: 16px; flex: 0 0 auto; }
  .bar { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; padding: 8px; background: #f4f4f4; border: 1px solid #ddd; border-radius: 4px; margin-bottom: 8px; flex: 0 0 auto; }
  .bar input[type=text] { padding: 3px 6px; border: 1px solid #bbb; border-radius: 3px; font-size: 13px; }
  button { padding: 5px 10px; border: 1px solid #888; background: #fff; border-radius: 3px; cursor: pointer; font-size: 13px; }
  button.primary { background: #2c7be5; color: white; border-color: #2c7be5; }
  button:disabled { opacity: 0.5; cursor: not-allowed; }
  .pill { display: inline-block; padding: 1px 8px; border-radius: 10px; background: #eee; font-size: 11px; margin-left: 6px; }
  .pill.ok { background: #d4edda; color: #155724; }
  .pill.bad { background: #f8d7da; color: #721c24; }
  .content { flex: 1 1 auto; overflow: auto; border: 1px solid #ddd; border-radius: 4px; min-height: 0; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { padding: 6px 10px; border-bottom: 1px solid #f0f0f0; text-align: left; vertical-align: top; }
  th { background: #fafafa; font-weight: 600; position: sticky; top: 0; z-index: 1; }
  .badge { display: inline-block; padding: 1px 6px; border-radius: 8px; font-size: 11px; }
  .badge.jobs { background: #fff3cd; color: #856404; }
  .badge.idle { background: #e2e3e5; color: #383d41; }
  .badge.status { background: #d1ecf1; color: #0c5460; }
  .mono { font-family: Menlo, Consolas, monospace; font-size: 12px; color: #555; }
  .empty { color: #aaa; font-style: italic; }
  .dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; flex: 0 0 auto; vertical-align: middle; margin-right: 6px; }
  .dot.unknown { background: #ccc; }
  .dot.alive { background: #2ecc71; }
  .dot.dead { background: #e74c3c; }
  .dot.warn { background: #d99c18; }
  .status-detail { display:block; color:#777; font-size:11px; margin-top:3px; }
  button.danger { background: #e74c3c; color: white; border-color: #c0392b; }
  .chip { display: inline-block; padding: 1px 6px; border-radius: 8px; font-size: 11px; margin: 1px 2px 1px 0; white-space: nowrap; }
  .chip.ok   { background: #d4edda; color: #155724; }
  .chip.warn { background: #fff3cd; color: #856404; }
  .chip.bad  { background: #f8d7da; color: #721c24; }
  .chip.na   { background: #e2e3e5; color: #383d41; }
  tr.printer { cursor: pointer; }
  tr.printer:hover { background: #f8f8ff; }
  tr.printer.selected { background: #eef6ff; }
  #jobsPanel { margin-top: 10px; flex: 0 0 auto; border: 1px solid #ddd; border-radius: 4px; max-height: 320px; display: flex; flex-direction: column; }
  #jobsPanel h3 { margin: 0; padding: 8px; background: #eee; font-size: 13px; display: flex; align-items: center; gap: 8px; }
  #jobsWrap { flex: 1 1 auto; overflow: auto; }
  #jobsTable { width: 100%; border-collapse: collapse; font-size: 12px; }
  #jobsTable th, #jobsTable td { padding: 4px 8px; border-bottom: 1px solid #f0f0f0; }
  #jobsTable th { background: #fafafa; position: sticky; top: 0; }
</style>
</head>
<body>

<h2>Print Control <span id="cfgState" class="pill">checking…</span></h2>

<div class="bar">
  <strong>Serveur(s) :</strong> <span id="srvHost" class="mono">—</span>
  <span style="flex:1"></span>
  <input type="text" id="search" placeholder="Filtrer (nom, partage, IP, driver…)" style="width:280px">
  <button id="refreshBtn" class="primary">Rafraîchir</button>
</div>

<div class="content">
  <table>
    <thead>
      <tr>
        <th>Nom</th>
        <th>Partage</th>
        <th>Port / IP</th>
        <th>Modèle</th>
        <th>Statut</th>
        <th>Localisation</th>
        <th>Jobs</th>
      </tr>
    </thead>
    <tbody id="tbody">
      <tr><td colspan="7" class="empty" style="padding:12px">Chargement…</td></tr>
    </tbody>
  </table>
</div>

<div id="jobsPanel" style="display:none">
  <h3>
    File d'attente — <span id="jobsTitle"></span>
    <span style="flex:1"></span>
    <button id="jobsPurge" class="danger">Vider la file</button>
    <button id="jobsRefresh">Rafraîchir</button>
    <button id="jobsClose">Fermer</button>
  </h3>
  <div id="jobsWrap">
    <table id="jobsTable">
      <thead><tr><th>ID</th><th>Utilisateur</th><th>Document</th><th>État</th><th>Pages</th><th>Taille</th><th>Soumis</th></tr></thead>
      <tbody id="jobsBody"></tbody>
    </table>
  </div>
</div>

<script>
  function $(id) { return document.getElementById(id); }
  function api(action, params) {
    var qs = 'action=' + encodeURIComponent(action);
    if (params) Object.keys(params).forEach(function (k) {
      qs += '&' + encodeURIComponent(k) + '=' + encodeURIComponent(params[k]);
    });
    return fetch('/pluginadmin.ashx?pin=printctl&' + qs, { credentials: 'include' }).then(function (r) { return r.json(); });
  }
  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
    });
  }

  var data = null;
  var selectedPrinter = null;
  // ip -> true when reachable, null when unconfirmed, undefined while probing.
  var pingState = {};
  // ip -> model string (or "" once we know there is none).
  var modelState = {};
  // "host|PrinterShortName" -> live job count from WMI (overrides rpcclient cjobs).
  var jobCountState = {};
  // ip -> {state: "prête"|"imprime"|…, errors: ["bourrage", "papier bas", …]}
  var statusState = {};
  // Periodic background refresh for the job-count column.
  var refreshTimer = null;
  var loadBusy = false;

  function printerIndicator(p) {
    var queue = p.queueStatus;
    if (queue && queue.known) {
      var levels = queue.states.map(function (s) { return s.level; });
      return { css: levels.indexOf('bad') !== -1 ? 'dead' : levels.indexOf('warn') !== -1 ? 'warn' : levels.indexOf('na') !== -1 ? 'unknown' : 'alive',
        title: 'Windows : ' + queue.states.map(function (s) { return s.label; }).join(', ') };
    }
    var snmp = statusState[p.ip];
    if (snmp && snmp.available && snmp.errors.length) return { css: 'warn', title: 'Alerte signalée par SNMP' };
    return pingState[p.ip] === true || (snmp && snmp.available)
      ? { css: 'alive', title: 'Joignable depuis MeshCentral ; état Windows inconnu' }
      : { css: 'unknown', title: 'État non confirmé' };
  }

  // The Windows queue, direct network access and SNMP are different observations.
  // Label each source and never turn a failed probe into an offline/OK assertion.
  function statusHtml(p) {
    var html = '';
    var queue = p.queueStatus;
    if (queue && queue.known) {
      html = queue.states.map(function (s) {
        var level = ['ok', 'warn', 'bad', 'na'].indexOf(s.level) !== -1 ? s.level : 'na';
        return '<span class="chip ' + level + '">Windows : ' + escapeHtml(s.label) + '</span>';
      }).join('');
    } else html = '<span class="chip na">État Windows inconnu</span>';
    var ip = p.ip;
    if (!ip) return html + '<span class="status-detail">Adresse IP non identifiée</span>';
    var s = statusState[ip];
    if (s && s.available) {
      if (s.errors.length) {
        html += s.errors.map(function (e) {
          return '<span class="chip bad">SNMP : ' + escapeHtml(e) + '</span>';
        }).join('');
      } else if (s.stateCode >= 3 && s.errorsKnown) {
        html += '<span class="chip ' + (s.stateCode === 3 ? 'ok' : 'warn') + '">SNMP : ' + escapeHtml(s.state) + '</span>';
      } else html += '<span class="status-detail">État SNMP incomplet</span>';
    } else if (s !== undefined) html += '<span class="status-detail">État SNMP indisponible</span>';
    var reachable = pingState[ip] === true || (s && s.available);
    html += '<span class="status-detail">' + (reachable ? 'Joignable depuis MeshCentral'
      : pingState[ip] === undefined ? 'Vérification réseau…' : 'Accès direct non confirmé') + '</span>';
    return html;
  }

  function render() {
    if (!data) return;
    var q = ($('search').value || '').toLowerCase().trim();
    var rows = (data.printers || []).filter(function (p) {
      if (!q) return true;
      return [p.printername, p.sharename, p.portname, p.drivername, p.comment, p.location]
        .some(function (v) { return (v || '').toLowerCase().indexOf(q) !== -1; });
    });
    if (!rows.length) {
      $('tbody').innerHTML = '<tr><td colspan="7" class="empty" style="padding:12px">Aucun résultat.</td></tr>';
      return;
    }
    // The short name (last UNC segment) is what users actually recognise; the full
    // \\host\name path is shown as subtitle in case someone needs to copy-paste it.
    $('tbody').innerHTML = rows.map(function (p) {
      var shortName = (p.printername || '').split('\\').pop();
      var sel = (selectedPrinter && selectedPrinter.name === shortName && selectedPrinter.host === p.server) ? ' selected' : '';
      var ip = p.ip || '';
      var indicator = printerIndicator(p);
      var model = modelState[ip];
      var modelCell = model ? escapeHtml(model)
        : p.drivername ? escapeHtml(p.drivername) + '<span class="status-detail">Pilote Windows</span>'
        : '<span class="empty">Modèle inconnu</span>';
      return '<tr class="printer' + sel + '" data-name="' + escapeHtml(shortName) + '" data-host="' + escapeHtml(p.server || '') + '">'
           +   '<td><span class="dot ' + indicator.css + '" title="' + escapeHtml(indicator.title) + '"></span><b>' + escapeHtml(shortName) + '</b>'
           +     '<div class="mono">' + escapeHtml(p.printername) + '</div>'
           +   '</td>'
           +   '<td>' + escapeHtml(p.sharename || '') + '</td>'
           +   '<td class="mono">' + escapeHtml(p.portname || '') + '</td>'
           +   '<td>' + modelCell + '</td>'
           +   '<td>' + statusHtml(p) + '</td>'
           +   '<td>' + escapeHtml(p.location || '') + '</td>'
           +   '<td>' + (function () {
                 // Prefer the live WMI count; fall back to the (often-wrong) cjobs
                 // from rpcclient if we haven't fetched counts yet for this server.
                 var key = (p.server || '') + '|' + shortName;
                 var n = jobCountState.hasOwnProperty(key) ? jobCountState[key] : (p.cjobs || 0);
                 return n > 0
                   ? '<span class="badge jobs">' + n + ' job' + (n > 1 ? 's' : '') + '</span>'
                   : '<span class="badge idle">vide</span>';
               })() + '</td>'
           + '</tr>';
    }).join('');
    [].slice.call(document.querySelectorAll('tr.printer')).forEach(function (tr) {
      tr.onclick = function () { openJobs(tr.getAttribute('data-name'), tr.getAttribute('data-host')); };
    });
  }

  // Win32_PrintJob.JobStatus is a bitmask; the human-friendly Status string is more
  // useful. We fall back to the bitmask if Status is empty.
  function openJobs(name, host) {
    selectedPrinter = { name: name, host: host || '' };
    render();
    $('jobsPanel').style.display = '';
    $('jobsTitle').textContent = name + (host ? '  (' + host + ')' : '');
    $('jobsBody').innerHTML = '<tr><td colspan="7" class="empty" style="padding:12px">Chargement…</td></tr>';
    api('jobs', { printer: name, host: host || '' }).then(function (r) {
      if (r.error) {
        $('jobsBody').innerHTML = '<tr><td colspan="7" class="empty" style="padding:12px;color:#721c24">' + escapeHtml(r.error) + '</td></tr>';
        return;
      }
      // The live result is the most accurate count we'll ever have for this
      // printer — update the badge from it (snapshots from countsAll can be
      // minutes stale).
      jobCountState[(host || '') + '|' + name] = (r.jobs || []).length;
      render();
      if (!r.jobs || !r.jobs.length) {
        $('jobsBody').innerHTML = '<tr><td colspan="7" class="empty" style="padding:12px">File vide.</td></tr>';
        return;
      }
      $('jobsBody').innerHTML = r.jobs.map(function (j) {
        var pages = (j.pagesprinted || '0') + ' / ' + (j.totalpages || '?');
        var size = j.size ? (Math.round(parseInt(j.size, 10) / 1024) + ' Ko') : '';
        // TimeSubmitted is WMI's CIM_DATETIME: yyyymmddHHMMSS.mmmmmm±zzz
        var submitted = j.submitted || '';
        var m = submitted.match(/^(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})/);
        if (m) submitted = m[1] + '-' + m[2] + '-' + m[3] + ' ' + m[4] + ':' + m[5] + ':' + m[6];
        return '<tr>'
             +   '<td class="mono">' + escapeHtml(j.jobid) + '</td>'
             +   '<td>' + escapeHtml(j.owner || '') + '</td>'
             +   '<td>' + escapeHtml(j.document || '') + '</td>'
             +   '<td>' + escapeHtml(j.status || j.jobstatus || '') + '</td>'
             +   '<td>' + escapeHtml(pages) + '</td>'
             +   '<td>' + escapeHtml(size) + '</td>'
             +   '<td class="mono">' + escapeHtml(submitted) + '</td>'
             + '</tr>';
      }).join('');
    });
  }

  function load(manual) {
    if (loadBusy) return Promise.resolve();
    loadBusy = true;
    $('refreshBtn').disabled = true;
    if (!data) $('tbody').innerHTML = '<tr><td colspan="7" class="empty" style="padding:12px">Chargement…</td></tr>';
    return api('list').then(function (r) {
      if (!r || r.error || !Array.isArray(r.printers)) throw new Error(r && r.error || 'Inventaire invalide');
      data = r;
      pingState = {};
      statusState = {};
      var errors = (r.errors || []).map(function (e) { return e.host + ' : ' + e.error; });
      $('cfgState').textContent = r.printers.length + ' imprimantes' + (errors.length ? ' · Inventaire partiel : ' + errors.join(' · ') : '');
      $('cfgState').className = errors.length ? 'pill bad' : 'pill ok';
      render();
      // Do not gate SNMP or model detection on ICMP. All workers are bounded;
      // wait for them before allowing the next refresh to overwrite their results.
      return Promise.all([pingAll(), modelsAll(), statusAll(manual !== false), countsAll()]);
    }).catch(function (e) {
      $('cfgState').textContent = 'Actualisation impossible : ' + e.message;
      $('cfgState').className = 'pill bad';
      if (data) {
        // A stale Windows state is not evidence of current availability.
        data.printers.forEach(function (p) { p.queueStatus = { known: false }; });
        pingState = {}; statusState = {};
        render();
      }
    }).then(function () {
      loadBusy = false;
      $('refreshBtn').disabled = false;
    });
  }

  // Probe each unique IPv4 port-name. Concurrency capped at 8
  // and to keep the spinner moving evenly across the rows. Returns a promise that
  // resolves once every queued IP has been probed.
  function pingAll() {
    if (!data) return Promise.resolve();
    var ips = {};
    (data.printers || []).forEach(function (p) {
      if (p.ip) ips[p.ip] = true;
    });
    var queue = Object.keys(ips);
    if (!queue.length) return Promise.resolve();
    var i = 0;
    function worker() {
      if (i >= queue.length) return Promise.resolve();
      var ip = queue[i++];
      return api('pingPrinter', { ip: ip }).then(function (r) {
        pingState[ip] = r && r.alive === true ? true : null;
      }).catch(function () { pingState[ip] = null; }).then(function () {
        render();
        return worker();
      });
    }
    var workers = [];
    for (var k = 0; k < Math.min(8, queue.length); k++) workers.push(worker());
    return Promise.all(workers);
  }

  // Fetch missing models independently of ICMP. Retry empty results on refresh.
  function modelsAll() {
    if (!data) return Promise.resolve();
    var ips = {};
    (data.printers || []).forEach(function (p) {
      if (p.ip && !modelState[p.ip]) ips[p.ip] = true;
    });
    var queue = Object.keys(ips);
    if (!queue.length) return Promise.resolve();
    var i = 0;
    function worker() {
      if (i >= queue.length) return Promise.resolve();
      var ip = queue[i++];
      return api('getModel', { ip: ip }).then(function (r) {
        if (r && typeof r.model === 'string') modelState[ip] = r.model;
      }).catch(function () {}).then(function () {
        render();
        return worker();
      });
    }
    var workers = [];
    for (var k = 0; k < Math.min(8, queue.length); k++) workers.push(worker());
    return Promise.all(workers);
  }

  api('ping').then(function (r) {
    if (r && Array.isArray(r.hosts) && r.hosts.length) {
      $('srvHost').textContent = r.hosts.map(function (h) {
        return h.host + (h.ok ? ' (' + h.count + ')' : ' [' + (h.error || 'KO') + ']');
      }).join(' · ');
    }
  });
  // Query every IP: SNMP can respond even when ICMP/TCP probes fail.
  function statusAll(force) {
    if (!data) return Promise.resolve();
    var ips = {};
    (data.printers || []).forEach(function (p) {
      if (p.ip) ips[p.ip] = true;
    });
    var queue = Object.keys(ips);
    if (!queue.length) return Promise.resolve();
    var i = 0;
    function worker() {
      if (i >= queue.length) return Promise.resolve();
      var ip = queue[i++];
      return api('getStatus', { ip: ip, force: force ? '1' : '0' }).then(function (r) {
        statusState[ip] = r && !r.error ? r : { available: false };
        if (!Array.isArray(statusState[ip].errors)) statusState[ip].errors = [];
      }).catch(function () { statusState[ip] = { available: false }; }).then(function () {
        render();
        return worker();
      });
    }
    var workers = [];
    for (var k = 0; k < Math.min(8, queue.length); k++) workers.push(worker());
    return Promise.all(workers);
  }

  // Get the authoritative job counts via WMI, one query per server.
  function countsAll() {
    if (!data) return Promise.resolve();
    var hosts = {};
    (data.printers || []).forEach(function (p) { if (p.server) hosts[p.server] = true; });
    return Promise.all(Object.keys(hosts).map(function (host) {
      return api('jobCounts', { host: host }).then(function (r) {
        if (!r || !r.counts) return;
        Object.keys(r.counts).forEach(function (printerName) {
          jobCountState[host + '|' + printerName] = r.counts[printerName];
        });
        render();
      }).catch(function () {});
    }));
  }

  $('search').oninput = render;
  $('refreshBtn').onclick = function () { load(true); };
  $('jobsRefresh').onclick = function () { if (selectedPrinter) openJobs(selectedPrinter.name, selectedPrinter.host); };
  $('jobsClose').onclick = function () { $('jobsPanel').style.display = 'none'; selectedPrinter = null; render(); };
  $('jobsPurge').onclick = function () {
    if (!selectedPrinter) return;
    if (!confirm('Vider TOUTE la file d\'attente de ' + selectedPrinter.name + ' ?\n\nLes jobs en cours seront supprimés sur le serveur d\'impression.')) return;
    $('jobsPurge').disabled = true;
    $('jobsPurge').textContent = 'Suppression…';
    api('purge', { printer: selectedPrinter.name, host: selectedPrinter.host || '' }).then(function (r) {
      $('jobsPurge').disabled = false;
      $('jobsPurge').textContent = 'Vider la file';
      if (r.error) { alert('Erreur: ' + r.error); return; }
      var msg = r.deleted + ' job(s) supprimé(s)';
      if (r.failed) {
        msg += ', ' + r.failed + ' échec(s)';
        if (r.errors && r.errors.length) {
          msg += '\n\nPremière erreur: ' + (r.errors[0].error || JSON.stringify(r.errors[0]));
          if (r.errors[0].path) msg += '\nPath: ' + r.errors[0].path;
        }
      } else if (r.deleted === 0 && r.matched > 0) {
        msg += '\n\n' + r.matched + ' job(s) trouvés mais 0 supprimés.';
        if (r.paths && r.paths.length) msg += '\nPath testé: ' + r.paths[0];
      } else if (r.deleted === 0 && r.matched === 0) {
        msg += '\n\nAucun job trouvé en WMI pour cette imprimante (alors qu\'ils sont dans la file côté serveur). Vérifie le format du nom.';
      }
      // Optimistic: the purge succeeded, force the badge to "vide" right away so
      // the UI doesn't lie until the WMI re-count catches up. countsAll() then
      // confirms from the server.
      jobCountState[selectedPrinter.host + '|' + selectedPrinter.name] = 0;
      render();
      alert(msg);
      openJobs(selectedPrinter.name, selectedPrinter.host);
      countsAll();
    });
  };
  load(true);
  refreshTimer = setInterval(function () { load(false); }, 30000);
</script>
</body>
</html>
